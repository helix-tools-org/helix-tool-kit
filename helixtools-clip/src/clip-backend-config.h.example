#pragma once

#define SUPABASE_PROJECT_ID  "your-supabase-project-id"
#define SUPABASE_BASE_URL    "https://" SUPABASE_PROJECT_ID ".supabase.co"
#define SUPABASE_ANON_KEY    "your-supabase-anon-key"

#define CLIP_API_URL         "https://your-clip-backend.example.com/api/v1/clip/clips/create"
