 * with this program. If not, see <https://www.gnu.org/licenses/>.
 */

#pragma once

#define MUSIC_SUPABASE_PROJECT_ID  "your-supabase-project-id"
#define MUSIC_SUPABASE_BASE_URL    "https://" MUSIC_SUPABASE_PROJECT_ID ".supabase.co"
#define MUSIC_SUPABASE_ANON_KEY    "your-supabase-anon-key"
